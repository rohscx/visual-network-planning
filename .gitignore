# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# macOS
.DS_Store

# Claude Code local settings (personal permission grants — not for public repo)
.claude/

# User plan data (private — each user keeps their own plans locally)
plans/*.json

# Source data (Infoblox exports etc. typically contain real environment info)
*.csv

# Offline-install bundle — built by scripts/build-wheelhouse.sh and
# published as a GitHub Release asset, not committed to the repo.
vnp-deps.tar.gz
wheelhouse/

# Transient working dir for scripts/build-wheelhouse.sh — the script tars
# this and removes it, but a Ctrl-C mid-run can leave it behind.
wheelhouse/
